IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=your-github-user/auto-parking
IMAGE_TAG=latest

APP_ENV=prod
DEBUG=false
LOG_LEVEL=INFO
WEB_CONCURRENCY=5
HTTP_PORT=80

POSTGRES_DB=auto_parking
POSTGRES_USER=auto_parking
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://auto_parking:change-me@db:5432/auto_parking

AUDIT_POSTGRES_DB=audit_db
AUDIT_POSTGRES_USER=audit_user
AUDIT_POSTGRES_PASSWORD=change-me

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30

REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_NOTIFICATION_CONSUMER_GROUP=auto-parking-notification-service
KAFKA_AUDIT_SOURCE_CONSUMER_GROUP=auto-parking-audit-service
GPS_CONSUMER_ENABLED=true

TELEGRAM_BOT_TOKEN=change-me
BOT_LOGIN_REGISTRY_TTL_SECONDS=604800
BOT_SUMMARY_CACHE_TTL_SECONDS=300

ENTITY_CACHE_TTL_SECONDS=300
VEHICLE_MODEL_CACHE_TTL_SECONDS=3600
VEHICLE_TRACK_CACHE_TTL_SECONDS=300
