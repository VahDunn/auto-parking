# Локальное окружение. Скопируйте файл в .env и не коммитьте .env.
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO

POSTGRES_DB=auto_parking
POSTGRES_USER=auto_parking
POSTGRES_PASSWORD=auto_parking
DATABASE_URL=postgresql+asyncpg://auto_parking:auto_parking@db:5432/auto_parking

AUDIT_POSTGRES_DB=audit_db
AUDIT_POSTGRES_USER=audit_user
AUDIT_POSTGRES_PASSWORD=audit_password
AUDIT_DATABASE_URL=postgresql+asyncpg://audit_user:audit_password@audit-db:5432/audit_db

JWT_SECRET_KEY=local-development-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30

REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_NOTIFICATION_CONSUMER_GROUP=auto-parking-notification-service
KAFKA_AUDIT_SOURCE_CONSUMER_GROUP=auto-parking-audit-service
GPS_CONSUMER_ENABLED=true

# Нужен только для профилей bot/notifications.
TELEGRAM_BOT_TOKEN=

# Нужен только для профиля alerts. Для группы обычно используется ID вида -100...
ALERT_TELEGRAM_CHAT_ID=
